FROM docker.io/golang:1.25.13-alpine AS build
WORKDIR /src
COPY tests/certwardenmock/ ./
RUN GO111MODULE=off CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cert-warden-mock .

FROM docker.io/alpine:latest
RUN addgroup -S certwardenmock \
    && adduser -S -G certwardenmock certwardenmock \
    && mkdir -p /test-ca \
    && chown certwardenmock:certwardenmock /test-ca
COPY --from=build /out/cert-warden-mock /usr/local/bin/cert-warden-mock
USER certwardenmock
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/cert-warden-mock"]
