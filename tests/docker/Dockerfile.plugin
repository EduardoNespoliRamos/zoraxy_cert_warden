FROM docker.io/golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o /out/com.eduardoramos.zoraxy.certwarden ./cmd/cert-sync

FROM docker.io/alpine:latest
COPY --from=builder /out/com.eduardoramos.zoraxy.certwarden /plugin/com.eduardoramos.zoraxy.certwarden
COPY tests/docker/entrypoint.plugin.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
